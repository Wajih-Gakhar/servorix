# Servorix Environment Configuration Template

# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/servorix?sslmode=require"

# Authentication & Session Security (Generate strong random strings in production)
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-here"

# Primary Base URL
NEXT_PUBLIC_APP_URL="https://servorix.com"

# Servorix AI Engine — Multi-Key Failover Pool (Google AI Studio)
# Primary Standard Keys:
GEMINI_API_KEY="AIzaSyYourPrimaryGeminiApiKeyHere"
GOOGLE_API_KEY="AIzaSyYourPrimaryGoogleApiKeyHere"

# Multi-Key Failover Pool (Optional extra keys for round-robin rotation & 429 quota protection):
GEMINI_API_KEY_1="AIzaSyGeminiKey1"
GEMINI_API_KEY_2="AIzaSyGeminiKey2"
GEMINI_API_KEY_3="AIzaSyGeminiKey3"
GEMINI_API_KEY_4="AIzaSyGeminiKey4"
GEMINI_API_KEY_5="AIzaSyGeminiKey5"

# Real-Time Messaging & WebSockets (Pusher / Socket.IO)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
